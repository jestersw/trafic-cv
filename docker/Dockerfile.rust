FROM rust:1-trixie AS build
RUN apt-get update \
    && apt-get install -y --no-install-recommends clang libclang-dev libopencv-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY rust-infer ./
RUN cargo build --release -p traffic-infer \
    && cp target/release/traffic-infer /traffic-infer

FROM debian:trixie-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
       libopencv-core410 libopencv-imgproc410 libopencv-videoio410 libopencv-imgcodecs410 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /traffic-infer /usr/local/bin/traffic-infer
WORKDIR /work
ENTRYPOINT ["traffic-infer"]
CMD ["--help"]
